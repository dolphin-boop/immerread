{
  "manifest_version": 3,
  "name": "译读",
  "version": "0.3.2",
  "minimum_chrome_version": "114",
  "description": "在 Chrome 右侧边栏中使用 LLM 翻译英文网页文章。",
  "permissions": ["storage", "scripting", "activeTab", "sidePanel", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*", "https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开译读"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
